{
  "realm": "momthathel",
  "enabled": true,
  "displayName": "Momthathel — Inspection System",
  "loginTheme": "keycloak",
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,

  "clients": [
    {
      "clientId": "momthathel-mobile",
      "name": "Momthathel Mobile App",
      "description": "Public client used by the Flutter mobile app + Spring Boot backend (resource server).",
      "rootUrl": "http://localhost:8989/",
      "adminUrl": "http://localhost:8989/",
      "baseUrl": "http://localhost:8989/",
      "surrogateAuthRequired": false,
      "enabled": true,
      "alwaysDisplayInConsole": false,
      "clientAuthenticatorType": "client-secret",
      "redirectUris": [
        "http://localhost:*",
        "http://localhost:8989/*",
        "http://localhost:3000/*",
        "momthathel://*"
      ],
      "webOrigins": ["*"],
      "notBefore": 0,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "publicClient": true,
      "frontchannelLogout": true,
      "protocol": "openid-connect",
      "attributes": {
        "oidc.ciba.grant.enabled": "false",
        "backchannel.logout.session.required": "true",
        "post.logout.redirect.uris": "*",
        "oauth2.device.authorization.grant.enabled": "true",
        "display.on.consent.screen": "false",
        "backchannel.logout.revoke.offline.tokens": "false"
      },
      "authenticationFlowBindingOverrides": {},
      "fullScopeAllowed": true,
      "nodeReRegistrationTimeout": -1,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ],
      "access": {
        "view": true,
        "configure": true,
        "manage": true
      }
    }
  ],

  "roles": {
    "realm": [
      { "name": "ADMIN",      "description": "System administrator — full access to all APIs" },
      { "name": "INSPECTOR",  "description": "Field inspector — primary mobile-app persona (ISM-2 → ISM-8)" },
      { "name": "SUPERVISOR", "description": "Inspection supervisor — reviews / approves cases" },
      { "name": "VIEWER",     "description": "Read-only access for reporting" }
    ]
  },

  "groups": [
    { "name": "GROUP-Admin",      "realmRoles": ["ADMIN"] },
    { "name": "GROUP-Inspector",  "realmRoles": ["INSPECTOR"] },
    { "name": "GROUP-Supervisor", "realmRoles": ["SUPERVISOR"] },
    { "name": "GROUP-Viewer",     "realmRoles": ["VIEWER"] }
  ],

