<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  id="Definitions_PerformInspection"
                  targetNamespace="http://aaseya.com/bpmn/momthathel"
                  exporter="Momthathel"
                  exporterVersion="1.0.0"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.9.0">

  <bpmn:process id="PerformInspection" name="Perform Inspection (ISM)" isExecutable="true">

    <!-- ════════════════════════════════════════════════════════════════════
         START EVENT — process kicked off via REST: POST /api/inspection/start
         Required input variables:
           inspectorId        (Long)
           licenseNumber      (String) — optional; null triggers no-license flow
           inspectionTypeId   (Long)
           caseFromMobileApp  (boolean)
         ════════════════════════════════════════════════════════════════════ -->
    <bpmn:startEvent id="StartEvent_Inspection" name="Start Inspection">
      <bpmn:outgoing>Flow_Start_to_SkipDecision</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- ── Decision: Is case from mobile app? (Pega: IsCaseFromMobileApp when) ── -->
    <bpmn:exclusiveGateway id="Gateway_IsCaseFromMobile" name="From mobile app?">
      <bpmn:incoming>Flow_Start_to_SkipDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_Mobile_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Mobile_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Mobile-app path: skip the inspector decision sub-flow -->
    <bpmn:callActivity id="CallActivity_SkipPerformInspection" name="Skip Perform Inspection">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="AdhocCreateCase" propagateAllChildVariables="true"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Mobile_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Skip_to_IGCommercial</bpmn:outgoing>
    </bpmn:callActivity>

    <!-- Non-mobile path: identify the visit first -->
    <bpmn:callActivity id="CallActivity_IdentifyInspectionVisit" name="Identify Inspection Visit">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="IdentifySituationOnNature" propagateAllChildVariables="true"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Mobile_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Identify_to_IGCommercial</bpmn:outgoing>
    </bpmn:callActivity>

    <!-- ── Decision: IG Commercial / GH scenario? (Pega: IsIGCommercialScenario) ── -->
    <bpmn:exclusiveGateway id="Gateway_IGCommercialScenario" name="IG-Comm / GH scenario?">
      <bpmn:incoming>Flow_Skip_to_IGCommercial</bpmn:incoming>
      <bpmn:incoming>Flow_Identify_to_IGCommercial</bpmn:incoming>
      <bpmn:outgoing>Flow_IGComm_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_IGComm_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_IGKnownViolatorCommercial" name="IG Known Violator (Commercial)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ig-known-violator-commercial"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_IGComm_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_IGComm_to_GH</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_GHStandingCommittee" name="GH Standing Committee Process">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="gh-standing-committee-process"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_IGComm_to_GH</bpmn:incoming>
      <bpmn:outgoing>Flow_GH_to_NewCase</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_CreateInspectionVisitData" name="Create Inspection Visit Data">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="create-inspection-visit-data"/>
        <zeebe:ioMapping>
          <zeebe:output source="=inspectionId" target="inspectionId"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GH_to_NewCase</bpmn:incoming>
      <bpmn:incoming>Flow_IGComm_No</bpmn:incoming>
      <bpmn:outgoing>Flow_NewCase_to_GHScheduled</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- ── Decision: GH Scheduled cases? (Pega: ISGHScheduled?) ── -->
    <bpmn:exclusiveGateway id="Gateway_ISGHScheduled" name="GH Scheduled?">
      <bpmn:incoming>Flow_NewCase_to_GHScheduled</bpmn:incoming>
      <bpmn:outgoing>Flow_GHScheduled_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_GHScheduled_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_ScheduleQualityCase" name="Schedule Quality Case">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="schedule-quality-case"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GHScheduled_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_ScheduleQuality_to_TypeOfVisit</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- ── Type of Visit decision (Pega: TypeOfVisit decision table) ── -->
    <bpmn:exclusiveGateway id="Gateway_TypeOfVisit" name="Type Of Visit">
      <bpmn:incoming>Flow_GHScheduled_No</bpmn:incoming>
      <bpmn:incoming>Flow_ScheduleQuality_to_TypeOfVisit</bpmn:incoming>
      <bpmn:outgoing>Flow_TypeOfVisit_Campaign</bpmn:outgoing>
      <bpmn:outgoing>Flow_TypeOfVisit_Adhoc</bpmn:outgoing>
      <bpmn:outgoing>Flow_TypeOfVisit_Routine</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- ── Campaign path -->
    <bpmn:callActivity id="CallActivity_CampaignUpdateLocation" name="Campaign Update Location Visit">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="IdentifySituationOnNature" propagateAllChildVariables="true"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_TypeOfVisit_Campaign</bpmn:incoming>
      <bpmn:outgoing>Flow_Campaign_to_IsCampaign</bpmn:outgoing>
    </bpmn:callActivity>

    <bpmn:exclusiveGateway id="Gateway_IsCampaignVisit" name="Is Campaign Visit?">
      <bpmn:incoming>Flow_Campaign_to_IsCampaign</bpmn:incoming>
      <bpmn:outgoing>Flow_IsCampaign_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_IsCampaign_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:callActivity id="CallActivity_EnterAndValidateClausesCampaign" name="Enter And Validate Clauses (Campaign)">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="EnterAndValidateClauses" propagateAllChildVariables="true"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_IsCampaign_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_CampaignClauses_to_End</bpmn:outgoing>
    </bpmn:callActivity>

    <!-- ── Adhoc path (license capture) -->
    <bpmn:callActivity id="CallActivity_AdhocCreateCase" name="Adhoc Create Case">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="AdhocCreateCase" propagateAllChildVariables="true"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_TypeOfVisit_Adhoc</bpmn:incoming>
      <bpmn:outgoing>Flow_Adhoc_to_IsCRMVD</bpmn:outgoing>
    </bpmn:callActivity>

    <!-- ── Routine path -->
    <bpmn:callActivity id="CallActivity_IdentifyEstablishment" name="Identify Establishment Details">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="IdentifySituationOnNature" propagateAllChildVariables="true"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_TypeOfVisit_Routine</bpmn:incoming>
      <bpmn:incoming>Flow_IsCampaign_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Identify_to_IsCRMVD</bpmn:outgoing>
    </bpmn:callActivity>

    <!-- ── Decision: Is CRM VD Incident? (Pega: IsCRMVDIncident) ── -->
    <bpmn:exclusiveGateway id="Gateway_IsCRMVDIncident" name="CRM VD Incident?">
      <bpmn:incoming>Flow_Adhoc_to_IsCRMVD</bpmn:incoming>
      <bpmn:incoming>Flow_Identify_to_IsCRMVD</bpmn:incoming>
      <bpmn:outgoing>Flow_CRMVD_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_CRMVD_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_SaveAttachmentsCommercial" name="Save Attachments For Commercial">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="save-attachments-for-commercial"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CRMVD_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_SaveAttach_to_CheckInspectors</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_CheckForInspectors" name="Check for Inspectors">
      <bpmn:incoming>Flow_SaveAttach_to_CheckInspectors</bpmn:incoming>
      <bpmn:incoming>Flow_CRMVD_No</bpmn:incoming>
      <bpmn:outgoing>Flow_HasInspectors_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_HasInspectors_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_ReassignToInspector" name="Reassign to Appropriate Inspector">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reassign-to-inspector"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_HasInspectors_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Reassign_to_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- ── Risk-based dispatch (CIS_AI_DEV) ── -->
    <bpmn:exclusiveGateway id="Gateway_IsRiskBasedDispatchNeeded" name="Risk-Based Dispatch Needed?">
      <bpmn:incoming>Flow_HasInspectors_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_RiskDispatch_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_RiskDispatch_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_RiskBasedDispatch" name="Risk Based Dispatch">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="risk-based-dispatch"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RiskDispatch_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_RiskDispatch_to_EnterClauses</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- ── Enter and validate clauses (main) ── -->
    <bpmn:callActivity id="CallActivity_EnterAndValidateClauses" name="Enter And Validate Clauses">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="EnterAndValidateClauses" propagateAllChildVariables="true"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RiskDispatch_No</bpmn:incoming>
      <bpmn:incoming>Flow_RiskDispatch_to_EnterClauses</bpmn:incoming>
      <bpmn:outgoing>Flow_EnterClauses_to_HasFailed</bpmn:outgoing>
    </bpmn:callActivity>

    <!-- ── Has Failed Clauses gateway (Pega: HasFailedClauses) ── -->
    <bpmn:exclusiveGateway id="Gateway_HasFailedClauses" name="Has Failed Clauses?">
      <bpmn:incoming>Flow_EnterClauses_to_HasFailed</bpmn:incoming>
      <bpmn:outgoing>Flow_Failed_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Failed_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_FetchEstbClassification" name="Fetch Establishment Classification">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="fetch-estb-classification"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Failed_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_FetchEstb_to_HasPM</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- ── PM Clauses gateway (Pega: HasPMClauses) ── -->
    <bpmn:exclusiveGateway id="Gateway_HasPMClauses" name="Has PM Clauses?">
      <bpmn:incoming>Flow_FetchEstb_to_HasPM</bpmn:incoming>
      <bpmn:outgoing>Flow_HasPM_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_HasPM_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_PrecautionaryMeasures" name="Precautionary Measures">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="precautionary-measures"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_HasPM_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_PM_to_ClosingAndReopen</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:callActivity id="CallActivity_ClosingAndReopen" name="Closing And Reopen">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="IdentifySituationOnNature" propagateAllChildVariables="true"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_HasPM_No</bpmn:incoming>
      <bpmn:incoming>Flow_PM_to_ClosingAndReopen</bpmn:incoming>
      <bpmn:outgoing>Flow_ClosingAndReopen_to_PerformDecision</bpmn:outgoing>
    </bpmn:callActivity>

    <bpmn:serviceTask id="Task_PerformInspectorDecision" name="Perform Inspector Decision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="perform-inspector-decision"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ClosingAndReopen_to_PerformDecision</bpmn:incoming>
      <bpmn:incoming>Flow_Failed_No</bpmn:incoming>
      <bpmn:outgoing>Flow_PerformDecision_to_UpdateTable</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_UpdateToEstVisitTable" name="Update To Est Visit Table">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="update-est-visit-table"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PerformDecision_to_UpdateTable</bpmn:incoming>
      <bpmn:outgoing>Flow_UpdateTable_to_QualityCheck</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- ── Decision: Is Quality Inspection? -->
    <bpmn:exclusiveGateway id="Gateway_IsQualityInspection" name="Is Quality Inspection?">
      <bpmn:incoming>Flow_UpdateTable_to_QualityCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_Quality_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Quality_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_ChangeToSpecificStage" name="Change to Specific Stage">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="change-to-specific-stage"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Quality_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_ChangeStage_to_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_Inspection_Complete" name="Inspection Complete">
      <bpmn:incoming>Flow_Quality_No</bpmn:incoming>
      <bpmn:incoming>Flow_ChangeStage_to_End</bpmn:incoming>
      <bpmn:incoming>Flow_CampaignClauses_to_End</bpmn:incoming>
      <bpmn:incoming>Flow_Reassign_to_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ════════════════════════════════════════════════════════════════════
         SEQUENCE FLOWS
         ════════════════════════════════════════════════════════════════════ -->
    <bpmn:sequenceFlow id="Flow_Start_to_SkipDecision" sourceRef="StartEvent_Inspection" targetRef="Gateway_IsCaseFromMobile"/>

    <bpmn:sequenceFlow id="Flow_Mobile_Yes" name="Yes" sourceRef="Gateway_IsCaseFromMobile" targetRef="CallActivity_SkipPerformInspection">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=caseFromMobileApp = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Mobile_No" name="No" sourceRef="Gateway_IsCaseFromMobile" targetRef="CallActivity_IdentifyInspectionVisit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=caseFromMobileApp != true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Skip_to_IGCommercial" sourceRef="CallActivity_SkipPerformInspection" targetRef="Gateway_IGCommercialScenario"/>
    <bpmn:sequenceFlow id="Flow_Identify_to_IGCommercial" sourceRef="CallActivity_IdentifyInspectionVisit" targetRef="Gateway_IGCommercialScenario"/>

    <bpmn:sequenceFlow id="Flow_IGComm_Yes" name="IG-Comm" sourceRef="Gateway_IGCommercialScenario" targetRef="Task_IGKnownViolatorCommercial">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isIGCommercialScenario = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_IGComm_No" name="Else" sourceRef="Gateway_IGCommercialScenario" targetRef="Task_CreateInspectionVisitData">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isIGCommercialScenario != true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_IGComm_to_GH" sourceRef="Task_IGKnownViolatorCommercial" targetRef="Task_GHStandingCommittee"/>
    <bpmn:sequenceFlow id="Flow_GH_to_NewCase" sourceRef="Task_GHStandingCommittee" targetRef="Task_CreateInspectionVisitData"/>
    <bpmn:sequenceFlow id="Flow_NewCase_to_GHScheduled" sourceRef="Task_CreateInspectionVisitData" targetRef="Gateway_ISGHScheduled"/>

    <bpmn:sequenceFlow id="Flow_GHScheduled_Yes" name="Yes" sourceRef="Gateway_ISGHScheduled" targetRef="Task_ScheduleQualityCase">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isGHScheduled = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_GHScheduled_No" name="No" sourceRef="Gateway_ISGHScheduled" targetRef="Gateway_TypeOfVisit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isGHScheduled != true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ScheduleQuality_to_TypeOfVisit" sourceRef="Task_ScheduleQualityCase" targetRef="Gateway_TypeOfVisit"/>

    <bpmn:sequenceFlow id="Flow_TypeOfVisit_Campaign" name="Campaign" sourceRef="Gateway_TypeOfVisit" targetRef="CallActivity_CampaignUpdateLocation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=typeOfVisit = "CAMPAIGN"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_TypeOfVisit_Adhoc" name="Adhoc" sourceRef="Gateway_TypeOfVisit" targetRef="CallActivity_AdhocCreateCase">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=typeOfVisit = "ADHOC"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_TypeOfVisit_Routine" name="Routine" sourceRef="Gateway_TypeOfVisit" targetRef="CallActivity_IdentifyEstablishment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=typeOfVisit = "ROUTINE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Campaign_to_IsCampaign" sourceRef="CallActivity_CampaignUpdateLocation" targetRef="Gateway_IsCampaignVisit"/>
    <bpmn:sequenceFlow id="Flow_IsCampaign_Yes" name="Yes" sourceRef="Gateway_IsCampaignVisit" targetRef="CallActivity_EnterAndValidateClausesCampaign">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isCampaignVisit = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_IsCampaign_No" name="No" sourceRef="Gateway_IsCampaignVisit" targetRef="CallActivity_IdentifyEstablishment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isCampaignVisit != true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CampaignClauses_to_End" sourceRef="CallActivity_EnterAndValidateClausesCampaign" targetRef="EndEvent_Inspection_Complete"/>

    <bpmn:sequenceFlow id="Flow_Adhoc_to_IsCRMVD" sourceRef="CallActivity_AdhocCreateCase" targetRef="Gateway_IsCRMVDIncident"/>
    <bpmn:sequenceFlow id="Flow_Identify_to_IsCRMVD" sourceRef="CallActivity_IdentifyEstablishment" targetRef="Gateway_IsCRMVDIncident"/>

    <bpmn:sequenceFlow id="Flow_CRMVD_Yes" name="Yes" sourceRef="Gateway_IsCRMVDIncident" targetRef="Task_SaveAttachmentsCommercial">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isCRMVDIncident = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CRMVD_No" name="No" sourceRef="Gateway_IsCRMVDIncident" targetRef="Gateway_CheckForInspectors">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isCRMVDIncident != true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SaveAttach_to_CheckInspectors" sourceRef="Task_SaveAttachmentsCommercial" targetRef="Gateway_CheckForInspectors"/>

    <bpmn:sequenceFlow id="Flow_HasInspectors_Yes" name="Yes" sourceRef="Gateway_CheckForInspectors" targetRef="Gateway_IsRiskBasedDispatchNeeded">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=hasInspectors = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_HasInspectors_No" name="No" sourceRef="Gateway_CheckForInspectors" targetRef="Task_ReassignToInspector">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=hasInspectors != true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Reassign_to_End" sourceRef="Task_ReassignToInspector" targetRef="EndEvent_Inspection_Complete"/>

    <bpmn:sequenceFlow id="Flow_RiskDispatch_Yes" name="Yes" sourceRef="Gateway_IsRiskBasedDispatchNeeded" targetRef="Task_RiskBasedDispatch">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isRiskBasedDispatchNeeded = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RiskDispatch_No" name="No" sourceRef="Gateway_IsRiskBasedDispatchNeeded" targetRef="CallActivity_EnterAndValidateClauses">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isRiskBasedDispatchNeeded != true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RiskDispatch_to_EnterClauses" sourceRef="Task_RiskBasedDispatch" targetRef="CallActivity_EnterAndValidateClauses"/>

    <bpmn:sequenceFlow id="Flow_EnterClauses_to_HasFailed" sourceRef="CallActivity_EnterAndValidateClauses" targetRef="Gateway_HasFailedClauses"/>

    <bpmn:sequenceFlow id="Flow_Failed_Yes" name="Failed" sourceRef="Gateway_HasFailedClauses" targetRef="Task_FetchEstbClassification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=hasFailedClauses = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Failed_No" name="No Failed" sourceRef="Gateway_HasFailedClauses" targetRef="Task_PerformInspectorDecision">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=hasFailedClauses != true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_FetchEstb_to_HasPM" sourceRef="Task_FetchEstbClassification" targetRef="Gateway_HasPMClauses"/>
    <bpmn:sequenceFlow id="Flow_HasPM_Yes" name="Has PM" sourceRef="Gateway_HasPMClauses" targetRef="Task_PrecautionaryMeasures">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=hasPMClauses = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_HasPM_No" name="No PM" sourceRef="Gateway_HasPMClauses" targetRef="CallActivity_ClosingAndReopen">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=hasPMClauses != true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PM_to_ClosingAndReopen" sourceRef="Task_PrecautionaryMeasures" targetRef="CallActivity_ClosingAndReopen"/>
    <bpmn:sequenceFlow id="Flow_ClosingAndReopen_to_PerformDecision" sourceRef="CallActivity_ClosingAndReopen" targetRef="Task_PerformInspectorDecision"/>

    <bpmn:sequenceFlow id="Flow_PerformDecision_to_UpdateTable" sourceRef="Task_PerformInspectorDecision" targetRef="Task_UpdateToEstVisitTable"/>
    <bpmn:sequenceFlow id="Flow_UpdateTable_to_QualityCheck" sourceRef="Task_UpdateToEstVisitTable" targetRef="Gateway_IsQualityInspection"/>

    <bpmn:sequenceFlow id="Flow_Quality_Yes" name="Quality" sourceRef="Gateway_IsQualityInspection" targetRef="Task_ChangeToSpecificStage">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isQualityInspection = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Quality_No" name="Else" sourceRef="Gateway_IsQualityInspection" targetRef="EndEvent_Inspection_Complete">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isQualityInspection != true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ChangeStage_to_End" sourceRef="Task_ChangeToSpecificStage" targetRef="EndEvent_Inspection_Complete"/>

  </bpmn:process>

